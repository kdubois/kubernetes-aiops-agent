# Secret for kubernetes-agent. Copy to secret.yaml, fill in the values, and
# apply it with the rest of the kustomization.
#
# Only analysis_api_key is required. The second opinion tier and the decision-model
# grader disable themselves when their keys are empty.
apiVersion: v1
kind: Secret
metadata:
  name: kubernetes-agent
type: Opaque
stringData:
  # Analysis model (any OpenAI-compatible endpoint)
  analysis_api_key: "YOUR_API_KEY"
  analysis_base_url: "https://api.openai.com/v1"
  analysis_model: "gpt-4o"

  # Optional: second opinion model for the escalation after a failed grade
  analysis_second_opinion_api_key: ""
  analysis_second_opinion_base_url: "https://api.openai.com/v1"
  analysis_second_opinion_model: ""

  # Optional: key for the decision-model grader
  typesafe_api_key: ""
