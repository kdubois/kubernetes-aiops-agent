# K8s Secret for kubernetes-agent.
# For Vault-based secret management, see the progressive-delivery README
# and set QUARKUS_PROFILE=prod,vault in the ConfigMap.
apiVersion: v1
kind: Secret
metadata:
  name: kubernetes-agent
type: Opaque
stringData:
  # Analysis model (used by DiagnosticsAgent, AnalysisAgent, ScoringAgent)
  analysis_api_key: "YOUR_API_KEY"
  analysis_base_url: "https://api.openai.com/v1"   # Or any OpenAI-compatible endpoint
  analysis_model: "gpt-4o"

  # Remediation model (used by RemediationAgent — can be same or different provider)
  remediation_api_key: "YOUR_REMEDIATION_API_KEY"   # Defaults to analysis key if omitted
  remediation_base_url: "https://api.openai.com/v1"
  remediation_model: "gpt-4o"

  # GitHub Configuration (required for PR creation)
  github_token: "YOUR_GITHUB_TOKEN"
